generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ------------------- ENUMS -------------------
enum Role {
  ADMIN
  OWNER
  GUEST
}

enum EventTypeKey {
  wedding
  birthday
  graduation
}

enum RSVPStatus {
  attending
  maybe
  not_attending
}

// ------------------- USERS -------------------
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  role          Role     @default(GUEST)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  events        Event[]  @relation("EventOwner")
  media         Media[]

  @@index([email])
}

// ------------------- EVENT TYPES -------------------
model EventType {
  id          String        @id @default(cuid())
  key         EventTypeKey  @unique
  name        String
  description String?
  config      Json

  events      Event[]

  @@index([key])
}

// ------------------- EVENTS -------------------
model Event {
  id              String       @id @default(cuid())
  slug            String       @unique
  title           String
  description     String?
  typeKey         EventTypeKey
  ownerId         String

  startDate       DateTime
  endDate         DateTime?
  startTime       String?
  endTime         String?
  timezone        String       @default("UTC")

  venueName       String?
  venueAddress    String?
  googleMapsUrl   String?

  contactPhone    String?
  contactEmail    String?

  coverImage      String?
  profileImage    String?
  backgroundImage String?

  backgroundAudio String?

  isPublic        Boolean      @default(true)
  isPublished     Boolean      @default(false)

  themeSettings   Json?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  owner           User         @relation("EventOwner", fields: [ownerId], references: [id])
  eventType       EventType    @relation(fields: [typeKey], references: [key])

  sections        EventSection[]
  stories         EventStory[]
  albums          GalleryAlbum[]
  videos          EventVideo[]
  schedules       ScheduleItem[]
  weddingParty    WeddingPartyMember[]
  rsvps           RSVP[]
  guestbook       GuestbookMessage[]
  songs           SongSuggestion[]

  @@index([slug])
  @@index([ownerId])
  @@index([typeKey])
  @@index([isPublished])
}

// ------------------- SECTIONS -------------------
model EventSection {
  id          String   @id @default(cuid())
  eventId     String
  sectionKey  String
  enabled     Boolean  @default(true)
  displayOrder Int     @default(0)

  event       Event    @relation(fields: [eventId], references: [id])

  @@unique([eventId, sectionKey])
  @@index([eventId])
}

// ------------------- STORY -------------------
model EventStory {
  id          String   @id @default(cuid())
  eventId     String
  title       String
  subtitle    String?
  content     String?
  image       String?
  video       String?
  displayOrder Int     @default(0)

  event       Event    @relation(fields: [eventId], references: [id])

  @@index([eventId])
}

// ------------------- GALLERY -------------------
model GalleryAlbum {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  description String?
  coverImage  String?
  displayOrder Int     @default(0)

  event       Event    @relation(fields: [eventId], references: [id])
  images      GalleryImage[]

  @@index([eventId])
}

model GalleryImage {
  id          String   @id @default(cuid())
  albumId     String
  url         String
  thumbnail   String?
  caption     String?
  altText     String?
  displayOrder Int     @default(0)

  album       GalleryAlbum @relation(fields: [albumId], references: [id])

  @@index([albumId])
}

// ------------------- VIDEOS -------------------
model EventVideo {
  id          String   @id @default(cuid())
  eventId     String
  title       String
  description String?
  thumbnail   String?
  videoUrl    String
  isFeatured  Boolean  @default(false)
  displayOrder Int     @default(0)

  event       Event    @relation(fields: [eventId], references: [id])

  @@index([eventId])
}

// ------------------- SCHEDULE -------------------
model ScheduleItem {
  id          String   @id @default(cuid())
  eventId     String
  title       String
  description String?
  date        DateTime?
  startTime   String?
  endTime     String?
  location    String?
  googleMapsUrl String?
  image       String?
  displayOrder Int     @default(0)

  event       Event    @relation(fields: [eventId], references: [id])

  @@index([eventId])
}

// ------------------- WEDDING PARTY -------------------
model WeddingPartyMember {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  role        String
  profileImage String?
  bio         String?
  socialLinks Json?
  displayOrder Int     @default(0)

  event       Event    @relation(fields: [eventId], references: [id])

  @@index([eventId])
  @@index([role])
}

// ------------------- RSVP -------------------
model RSVP {
  id          String       @id @default(cuid())
  eventId     String
  guestId     String?
  name        String
  email       String?
  phone       String?
  status      RSVPStatus   @default(attending)
  numberOfGuests Int       @default(1)
  guestNames  String?
  message     String?
  dietaryRequirements String?
  specialRequests String?
  rsvpDate    DateTime     @default(now())

  event       Event        @relation(fields: [eventId], references: [id])

  @@unique([eventId, email])
  @@index([eventId])
  @@index([status])
}

// ------------------- GUESTBOOK -------------------
model GuestbookMessage {
  id          String         @id @default(cuid())
  eventId     String
  name        String
  message     String
  photo       String?
  approved    Boolean        @default(false)
  pinned      Boolean        @default(false)
  createdAt   DateTime       @default(now())

  event       Event          @relation(fields: [eventId], references: [id])

  @@index([eventId])
  @@index([approved])
  @@index([createdAt])
}

// ------------------- SONG SUGGESTIONS -------------------
model SongSuggestion {
  id          String   @id @default(cuid())
  eventId     String
  guestName   String
  songTitle   String
  artist      String?
  youtubeUrl  String?
  spotifyUrl  String?
  message     String?
  approved    Boolean  @default(false)
  votes       Int      @default(0)
  createdAt   DateTime @default(now())

  event       Event    @relation(fields: [eventId], references: [id])

  @@index([eventId])
  @@index([approved])
  @@index([votes])
}

// ------------------- MEDIA -------------------
model Media {
  id          String   @id @default(cuid())
  userId      String
  url         String
  type        String
  mimeType    String?
  size        Int?
  metadata    Json?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
}